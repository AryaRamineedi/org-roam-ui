# org-ascipio
#
# NOTE: /dist (the built frontend) is intentionally NOT ignored -- it is
# committed so installing the Emacs package (org-ascipio.el etc.) requires
# nothing but Emacs, no Node/pnpm build step. Only app/'s own local build
# output and node_modules are ignored; `app/npm run build:dist` writes the
# real artifact into /dist.

# frontend (app/)
app/node_modules
app/dist
app/*.tsbuildinfo
app/coverage

# Tauri (src-tauri/)
src-tauri/target
src-tauri/gen

# elisp
*.elc

# misc
.DS_Store
*.pem
*.log
.env.local
.env.*.local

# legacy/ (old org-roam-ui reference project) keeps its own build/deps ignored too
legacy/node_modules
legacy/.next/
legacy/build
